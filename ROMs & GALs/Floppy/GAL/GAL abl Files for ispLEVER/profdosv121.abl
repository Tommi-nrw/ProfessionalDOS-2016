MODULE ProfDosV121
Declarations

"O0	Fetch 2MHz mode (A13 bei 1571)
"O1	Eprom A13(A14-ext bei1571)
"O2	RAM-/CS1, enabling line to IC9
"O3	Select-A[0..3|4..7]->AL, (enabling line to IC4)
"O4	ROM-/CE, enabling line to IC8
"O5	A12 -Ext
"O6	/EN-A[4..7]->AH, enabling line to IC5, pin 1
"O7	Eprom A14
"O8	A15 - Ext 
"O9	A11 - Ext

"Belegung für V.04 Platine

"A11,A15,A14,A13,A12,off,ram,low,high,C1571	pin 8,7,6,5,4,1,9,10,11,13;
"O0,O1,O2,O3,O4,O5,O6,O7,O8,O9			pin 15,18,20,17,19,14,22,21,16,23 istype 'com';


"Belegung für Prototyp Platine

"A11,A15,A14,A13,A12,off,high,ram,low,C1571	pin 7..1,10,9,11;
"O0,O1,O2,O3,O4,O5,O6,O7,O8,O9			pin 14..23 istype 'com';


"Belegung für Prototyp V1,1 Platine

"off,ram,low,!high,C1571,A11,A15,A14,A13,A12	pin 13,11..3;
"O0,O1,O2,O3,O4,O5,O6,O7,O8,O9			pin 14,15,16,17,18,22,20,21,19,23 istype 'com';

