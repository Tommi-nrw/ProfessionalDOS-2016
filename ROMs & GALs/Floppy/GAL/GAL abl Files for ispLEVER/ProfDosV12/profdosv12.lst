0002 |
0003 |Declarations
0004 |
0005 |"O0	Fetch 2MHz mode (A13 bei 1571)
0006 |"O1	Eprom A13(A14-ext bei1571)
0007 |"O2	RAM-/CS1, enabling line to IC9
0008 |"O3	Select-A[0..3|4..7]->AL, (enabling line to IC4)
0009 |"O4	ROM-/CE, enabling line to IC8
0010 |"O5	A12 -Ext
0011 |"O6	/EN-A[4..7]->AH, enabling line to IC5, pin 1
0012 |"O7	Eprom A14
0013 |"O8	A15 - Ext 
0014 |"O9	A11 - Ext
0015 |
0016 |"Belegung für V.04 Platine
0017 |
0018 |"A11,A15,A14,A13,A12,off,ram,low,high,C1571	pin 8,7,6,5,4,1,9,10,11,13;
0019 |"O0,O1,O2,O3,O4,O5,O6,O7,O8,O9			pin 15,18,20,17,19,14,22,21,16,23 istype 'com';
