      NODE26_o <= GND after g_delay ( NODE26_o,tpLH_iob,tpHL_iob);
      NODE26_ob <=  not(GND) after g_delay ( NODE26_ob,tpLH_iob,tpHL_iob);
      O5 <= O5_ODUMMY;
      O0 <= O0_ODUMMY;
      O8 <= O8_ODUMMY;
      O3 <= O3_ODUMMY;
      O1 <= O1_ODUMMY;
      O4 <= O4_ODUMMY;
      O2 <= O2_ODUMMY;
      O7 <= O7_ODUMMY;
      O6 <= O6_ODUMMY;
      O9 <= O9_ODUMMY;
END structure;
