0002 |Declarations
0003 |
0004 |"O0	Fetch 2MHz mode (A13 bei 1571)
0005 |"O1	Eprom A13(A14-ext bei1571)
0006 |"O2	RAM-/CS1, enabling line to IC9
0007 |"O3	Select-A[0..3|4..7]->AL, (enabling line to IC4)
0008 |"O4	ROM-/CE, enabling line to IC8
0009 |"O5	A12 -Ext
0010 |"O6	/EN-A[4..7]->AH, enabling line to IC5, pin 1
0011 |"O7	Eprom A14
0012 |"O8	A15 - Ext 
0013 |"O9	A11 - Ext
0014 |
