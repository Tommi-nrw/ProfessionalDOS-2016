P22V10G Programmed Logic:
--------------------------------------------------------------------------------



O8     = (  !A14 & A15 & Dolphin 
          #   A15 & high & off & Dolphin 
          #   !A13 & A15 & !low & Dolphin );

O5     = !(  !A12 & A13 & !A14 & !A15 
          #   !A12 & !A15 & off 
          #   !A12 & !A14 & !A15 & !ram 
          #   A11 & !A12 & !A14 & Dolphin 
          #   !A12 & !A13 & !A14 & A15 & Dolphin 
          #   !A12 & A14 & high & off & Dolphin 
          #   !A12 & !A13 & A15 & !low & Dolphin 
          #   !A12 & !A15 & !Dolphin );

O9     = (  A11 & !A15 & off 
          #   A11 & !A14 & Dolphin 
          #   A11 & high & off & Dolphin 
          #   A11 & !A13 & A15 & !low & Dolphin 
          #   A11 & !A15 & !Dolphin );

O7     = (  A13 & A14 & !off & Dolphin 
          #   A14 & A15 & !Dolphin );

O1     = (  A13 & A14 & A15 & !high 
          #   A13 & A14 & A15 & !off 
          #   A13 & A15 & !Dolphin );

O4     = !(  A13 & A14 & A15 & !high 
          #   A14 & A15 & !high & low 
          #   A14 & A15 & !off & low 
          #   A13 & A14 & !off & Dolphin 
          #   A13 & A15 & !Dolphin 
          #   A14 & A15 & !Dolphin );

O2     = !(  !A13 & A14 & !A15 & !off & Dolphin 
          #   !A11 & !A12 & !A13 & !A15 & !off & ram & Dolphin 
          #   !A13 & !A14 & A15 & !Dolphin );

O6     = (  A12 & A13 & A14 & !A15 & !off & Dolphin );

O3     = (  A11 & A12 & A13 & A14 & !A15 & !off & Dolphin );

O0     = (  A11 & !A12 & A13 & A14 & !A15 & !off & Dolphin );



